PLAYLIST_URL=""
BASE_URL="http://localhost:8000"
RANDOMIZE_PLAYLIST=True

# How often to re-fetch the YouTube playlist in the background (minutes).
# Set to 0 to disable auto-refresh.
PLAYLIST_REFRESH_INTERVAL_MINUTES=60

# Path to a cookies.txt file for YouTube auth. Required when YouTube bot-blocks
# the server's IP — export cookies from a logged-in browser session
# (e.g. via a "Get cookies.txt" browser extension). Leave unset on non-flagged IPs.
COOKIES_FILE=

# --- Residential proxy (DataImpulse) — consumed by the proxied-fetch routing
# (cloud-radio issue 03). Leave both unset to run direct from the home IP.
# When set, every YouTube fetch (playlist / metadata / media) rides the
# proxy with one sticky session per track (metadata + media share one exit
# IP), upstream audio is capped at <=56 kbps, and COOKIES_FILE is ignored on
# the proxied path. The proxy URL is built at runtime from these credentials
# — never hardcode it.
# DATAIMPULSE_USER=
# DATAIMPULSE_PASS=


# --- Pause alerts (cloud-radio issue 05) — sent via the Resend Email API.
# Create an API key at resend.com/dashboard/api-keys and verify the sender
# domain/address on your Resend account. When these are set, a guardrail
# pause (failure budget exhausted, or proxy traffic exhausted) emails the
# last yt-dlp stderr excerpt and the failure counters. The API key is never
# logged. Leave unset to pause without alerting.
# RESEND_API_KEY=
# ALERT_EMAIL_FROM=
# ALERT_EMAIL_TO=
# PAUSE_RESUME_COOLDOWN_MINUTES=30
